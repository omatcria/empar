<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>AbacatePay — Design System</title>
<style>
  :root{
    /* Tokens semânticos reais */
    --color-primary:#9eea6c; --color-primary-content:#fff;
    --color-secondary:#fff;  --color-secondary-content:#4b5563;
    --color-accent:oklch(77% .152 181.912); --color-neutral:#d4d4d8;
    --color-base-100:#fff; --color-base-200:oklch(98% 0 0); --color-base-300:oklch(95% 0 0);
    --color-base-content:oklch(21% .006 285.885);
    --color-success:#f1ffd4; --color-success-content:#578546;
    --color-error:#ffeaea;   --color-error-content:#b83131;
    --color-warning:#fff6e9; --color-warning-content:#b5850b;
    --color-info:oklch(74% .16 232.661); --color-info-content:oklch(29% .066 243.157);
    --color-chart-grid:#e2e7f1; --color-chart-text-secondary:#8a8aa3;
    --font-fustat:"Fustat",'Segoe UI',system-ui,sans-serif;
    --radius-field:.5rem; --radius-xl:.75rem; --radius-2xl:1rem;
  }
  *{box-sizing:border-box}
  body{font-family:var(--font-fustat);background:var(--color-base-200);color:var(--color-base-content);margin:0;padding:40px;line-height:1.5}
  h1{font-size:26px;font-weight:600;margin:0 0 4px}
  h2{font-size:18px;font-weight:600;margin:40px 0 16px;border-bottom:1px solid var(--color-chart-grid);padding-bottom:8px}
  .sub{color:var(--color-chart-text-secondary);font-size:14px}
  .grid{display:flex;flex-wrap:wrap;gap:16px}
  .swatch{width:170px;border:1px solid var(--color-chart-grid);border-radius:var(--radius-field);overflow:hidden;background:#fff}
  .swatch .c{height:64px} .swatch .i{padding:8px 12px;font-size:12px}
  .swatch .i b{display:block;font-size:13px} .swatch .i span{color:var(--color-chart-text-secondary)}
  .btn{font:600 14px var(--font-fustat);border-radius:var(--radius-field);padding:8px 12px;cursor:pointer;border:1px solid}
  .btn-primary{background:var(--color-primary);color:var(--color-base-content);border-color:var(--color-primary)}
  .btn-secondary{background:var(--color-secondary);color:var(--color-base-content);border-color:var(--color-chart-grid)}
  .btn-accent{background:#fea94c;color:#fff;border-color:#fff;padding:8px 16px}
  .badge{padding:4px 10px;border-radius:100px;font-size:12px;font-weight:600;display:inline-block}

  /* Widget de gráfico — fiel ao markup */
  .widget{border:1px solid var(--color-chart-grid);background:var(--color-base-100);padding:16px;border-radius:12px;width:420px}
  .widget header{display:flex;align-items:center;gap:8px;height:24px}
  .widget header h3{font-size:16px;font-weight:600;line-height:24px;flex:1;margin:0;color:var(--color-base-content)}
  .widget .info{width:20px;height:20px;border-radius:6px;border:none;background:none;color:var(--color-chart-text-secondary);cursor:pointer}
  .widget hr{width:100%;height:1px;background:#E2E7F1;border:none;margin:16px 0}
  .figure{min-height:200px;display:flex;gap:8px}
  .axis{font-size:12px;color:var(--color-chart-text-secondary);line-height:1}
  .plot{flex:1;border:1px solid var(--color-chart-grid);border-radius:4px;position:relative;overflow:hidden;
    background-image:repeating-linear-gradient(to bottom,transparent 0 39px,var(--color-chart-grid) 39px 40px)}
  /* área com gradiente da primary */
  .area{position:absolute;left:0;right:0;bottom:0;height:60%;
    background:linear-gradient(var(--color-primary) 0%, rgba(158,234,108,.4) 50%, rgba(158,234,108,0) 100%);
    opacity:.8;clip-path:polygon(0 60%,25% 30%,50% 45%,75% 15%,100% 40%,100% 100%,0 100%)}
  .dot{position:absolute;width:10px;height:10px;border-radius:50%;background:#fff;border:2px solid var(--color-primary);top:15%;left:75%;box-shadow:0 4px 2px rgba(0,0,0,.1)}
  .tooltip{position:absolute;top:8px;left:55%;background:var(--color-base-100);border:1px solid var(--color-chart-grid);border-radius:8px;padding:8px 12px;box-shadow:0 1px 3px rgba(0,0,0,.08);font-size:12px}
  .tooltip .d{color:var(--color-chart-text-secondary);margin:0 0 2px} .tooltip .v{font-weight:600;font-size:14px;margin:0}
</style>
</head>
<body>
  <h1>AbacatePay — Design System</h1>
  <p class="sub">Tailwind v4 + DaisyUI · tokens semânticos · fonte Fustat</p>

  <h2>Tokens Semânticos</h2>
  <div class="grid">
    <div class="swatch"><div class="c" style="background:var(--color-primary)"></div><div class="i"><b>primary</b><span>#9EEA6C</span></div></div>
    <div class="swatch"><div class="c" style="background:var(--color-accent)"></div><div class="i"><b>accent (teal)</b><span>oklch 77% .152 181</span></div></div>
    <div class="swatch"><div class="c" style="background:var(--color-neutral)"></div><div class="i"><b>neutral</b><span>#D4D4D8</span></div></div>
    <div class="swatch"><div class="c" style="background:var(--color-base-content)"></div><div class="i"><b>base-content</b><span>oklch 21%</span></div></div>
    <div class="swatch"><div class="c" style="background:var(--color-base-200);border-bottom:1px solid #eee"></div><div class="i"><b>base-200</b><span>oklch 98%</span></div></div>
    <div class="swatch"><div class="c" style="background:var(--color-chart-grid)"></div><div class="i"><b>chart-grid</b><span>#E2E7F1</span></div></div>
    <div class="swatch"><div class="c" style="background:var(--color-chart-text-secondary)"></div><div class="i"><b>chart-text-2</b><span>#8A8AA3</span></div></div>
  </div>

  <h2>Estados (suaves)</h2>
  <div class="grid">
    <span class="badge" style="background:var(--color-success);color:var(--color-success-content)">success</span>
    <span class="badge" style="background:var(--color-error);color:var(--color-error-content)">error</span>
    <span class="badge" style="background:var(--color-warning);color:var(--color-warning-content)">warning</span>
    <span class="badge" style="background:var(--color-info);color:#fff">info</span>
  </div>

  <h2>Botões</h2>
  <div class="grid" style="align-items:center">
    <button class="btn btn-primary">Hoje</button>
    <button class="btn btn-secondary">Esse mês</button>
    <button class="btn btn-accent">Ir para produção</button>
  </div>

  <h2>Widget de gráfico (Dashboard)</h2>
  <div class="widget">
    <header>
      <svg width="18" height="12" viewBox="0 0 18 12"><path d="M14.9 2.5A8.7 8.7 0 0 0 8.7 0C3.9 0 0 4 0 8.8v1.8A1.25 1.25 0 0 0 1.25 12h15A1.25 1.25 0 0 0 17.5 10.6V8.75A8.7 8.7 0 0 0 14.9 2.5z" fill="#8a8aa3"/></svg>
      <h3>Desempenho de vendas</h3>
      <button class="info" title="Visualize o volume de vendas">ⓘ</button>
    </header>
    <hr>
    <div class="figure">
      <div class="axis">0</div>
      <div class="plot">
        <div class="area"></div>
        <div class="dot"></div>
        <div class="tooltip">
          <p class="d">07/07/26</p>
          <p class="v">0 vendas</p>
          <p class="d">R$ 0,00</p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>